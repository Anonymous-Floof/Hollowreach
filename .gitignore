# CMake build trees (all configurations) and the dependencies FetchContent pulls
# into them. Everything here is reproducible from a clean checkout by build.bat.
build/

# Runtime data the game creates beside the executable in a portable install:
# worlds, screenshots, exports, settings.json, player.txt.
data/

# Release zips and notes built by tools/release.py.
dist/

# Local Claude Code state, except the launch configuration, which is project
# setup rather than anybody's personal preference.
.claude/*
!.claude/launch.json

# A data directory the game made somewhere it should not have. This happens when
# a scripted run passes --data-dir with an empty value and the flag swallows the
# next argument instead: you get a folder literally called "--world", holding a
# log with this machine's absolute asset path in it. Ignored because the cost of
# not noticing is publishing a build machine's username, which is the one thing
# the release check exists to catch.
--*/
data/


# Python bytecode. A .pyc embeds the absolute path of the source it was
# compiled from, so one committed from this tree carries the build machine.
__pycache__/
*.pyc
